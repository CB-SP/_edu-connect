                            ` : `
                                <button class="edit-action"
                                    data-id="${school.id}"
                                    data-type="user">
                                    Editar
                                </button>

                                <button class="delete-action"
                                    onclick="window.location.href='/_edu-connect/admin/delete_school/${school.id}'">
                                    Eliminar
                                </button>
                            `}

                        </div>
                    </td>
                </tr>
            `;
        });

        html += `
                </tbody>
            </table>
        `;

        schoolsResults.innerHTML = html;
    }
</script>

