<script>
    const input = document.getElementById('searchUser');
    const results = document.getElementById('usersResults');

    let timeout;

    input.addEventListener('input', () => {

        clearTimeout(timeout);

        timeout = setTimeout(async () => {

            const term = input.value.trim();

            try {

                const response = await fetch(
                    `http://localhost/_edu-connect/user/search_users/${encodeURIComponent(term)}`
                );

                const data = await response.json();

                renderUsers(data.users);

            } catch (error) {
                console.log(error);
            }

        }, 300);

    });

    function renderUsers(users) {
        if (!users || users.length === 0) {
            results.innerHTML = `<p>Nenhum usuário encontrado.</p>`;
            return;
        }

        let html = `
            <table class="tbl-users">
                <thead>
                    <tr>
                        <th>Usuário</th>
                        <th>Escola</th>
                        <th>Função</th>
                        <th>Estado</th>
                        <th>Acções</th>
                    </tr>
                </thead>
                <tbody>
        `;

        users.forEach(user => {

            const isInactive = user.deleted_at !== null;
            const role = user.coordinator_role ?? user.role;
            const status = isInactive ? 'Inactivo' : 'Activo';

            html += `
                <tr>
                    <td>${user.nome}</td>
                    <td>${user.escola}</td>
                    <td>${role}</td>
                    <td>${status}</td>

                    <td class="btn-down-actions">
                        <button class="action-btn">Acções</button>

                        <div class="drop-actions">

                            ${isInactive ? `
                                <button class="restore-action"
                                    onclick="window.location.href='/_edu-connect/admin/restore_user/${user.id}'">
                                    Restaurar
                                </button>
                            ` : `
                                <button class="edit-action"
                                    data-id="${user.id}"
                                    data-type="user">
                                    Editar
                                </button>

                                <button class="delete-action"
                                    onclick="window.location.href='/_edu-connect/admin/delete_user/${user.id}'">
                                    Eliminar
                                </button>
                            `}

                        </div>
                    </td>
                </tr>
            `;
        });

        html += `
                </tbody>
            </table>
        `;

        results.innerHTML = html;
    }
</script>

<script>
    const inputSchool = document.getElementById('searchSchool');
    const schoolsResults = document.getElementById('schoolsResults');

    inputSchool.addEventListener('input', () => {

        clearTimeout(timeout);

        timeout = setTimeout(async () => {

            const term = inputSchool.value.trim();

            try {

                const response = await fetch(
                    `http://localhost/_edu-connect/school/search_schools/${encodeURIComponent(term)}`
                );

                const data = await response.json();

                renderSchools(data.schools);

            } catch (error) {
                console.log(error);
            }

        }, 300);

    });

    function renderSchools(schools) {
