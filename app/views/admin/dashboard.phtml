            schoolsResults.innerHTML = `<p>Nenhuma escola encontrada.</p>`;
            return;
        }

        let html = `
            <table class="tbl-schools">
                <thead>
                    <tr>
                        <th>Escola</th>
                        <th>Contacto</th>
                        <th>Estado</th>
                        <th>Acções</th>
                    </tr>
                </thead>
                <tbody>
        `;

        schools.forEach(school => {

            const isInactive = school.deleted_at !== null;
            const status = isInactive ? 'Inactivo' : 'Activo';

            html += `
                <tr>
                    <td>${school.nome}</td>
                    <td>${school.contacto_1}</td>
                    <td>${status}</td>
                    <td class="btn-down-actions">
                        <button class="action-btn">Acções</button>

                        <div class="drop-actions">

